{# src/pages/where-am-i.njk — the start of the question flow. #}
{% extends "layouts/base.njk" %}
{% from "govuk/components/button/macro.njk" import govukButton %}
{% block pageContent %}
<div class="govuk-grid-row"><div class="govuk-grid-column-two-thirds">
<h1 class="govuk-heading-xl">Where is my plan?</h1>
<p class="govuk-body-l">Answer up to four questions and get a page that says which stage your plan is at, what has to happen next, and what the next gateway will ask for.</p>
<p class="govuk-body">Your answers stay in this browser tab. Nothing is stored or sent.</p>
{{ govukButton({ text: "Start now", href: rel('/where-am-i/' + navigator.start + '/'), isStartButton: true }) }}
<h2 class="govuk-heading-m">Or go straight to a stage</h2>
<p class="govuk-body">If you already know where you are, the <a class="govuk-link" href="{{ rel('/process/') }}">process map</a> lists every stage.</p>
</div></div>
{% endblock %}
